/* ────────────────────────────────────────────────────────────
   资料库页：与主窗口同底色 #101215，侧栏透明，分区只用分割线
   ──────────────────────────────────────────────────────────── */
QWidget#library_page,
QWidget#library_garden,
QWidget#library_detail_page,
QWidget#pack_form {
    background-color: #101215;
}

QWidget#library_tree_side,
QWidget#library_center,
QStackedWidget#library_center_stack,
QWidget#library_ring_page,
QWidget#library_detail,
QScrollArea#library_scroll,
QWidget#library_scroll_content {
    background-color: transparent;
    border: none;
}

QWidget#ring_strip,
QWidget#segment_canvas {
    background-color: #0d1117;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
}

QStackedWidget#ring_canvas_stack {
    background-color: transparent;
    border: none;
}

/* 图层窗口：和画布同样的深底 + 细边框，右侧整块面板一眼能和画布区分开 */
QWidget#layer_window {
    background-color: #15181d;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
}

QLabel#layer_window_title {
    background: transparent;
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.88);
}

QLabel#layer_window_caption {
    background: transparent;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.55);
}

QFrame#layer_window_separator {
    background-color: rgba(255, 255, 255, 0.08);
    border: none;
}

/* 树区域单独一圈边框，和工具栏、改图区分开 */
QWidget#layer_window QScrollArea#ring_layer_scroll {
    background-color: #0d1117;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
}

/* 拖动屏换位时的插入线 */
QFrame#layer_drop_marker {
    background-color: #7B9DBC;
    border: none;
}

QTextEdit#layer_prompt {
    background-color: #0d1117;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    padding: 4px;
}

QTextEdit#layer_prompt:focus {
    border-color: rgba(123, 157, 188, 0.75);
}

/* 图层窗口顶部的四个工具按钮；运行中的那个高亮，提示"再点一次停止" */
QPushButton#layer_tool_btn {
    padding: 4px 10px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.04);
}

QPushButton#layer_tool_btn:hover:enabled {
    background-color: rgba(123, 157, 188, 0.30);
}

QPushButton#layer_tool_btn:disabled {
    color: rgba(255, 255, 255, 0.30);
    border-color: rgba(255, 255, 255, 0.06);
}

QPushButton#layer_tool_btn[running="true"] {
    color: #ffd666;
    border-color: #ffd666;
    background-color: rgba(255, 214, 102, 0.14);
}

/* 条带右上角的前/后开关：半透明底色，压在画面上也看得清 */
QFrame#ring_compare_bar {
    background-color: rgba(13, 17, 23, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
}

QFrame#ring_segment_cell {
    border: none;
    border-radius: 2px;
    background-color: rgba(255, 255, 255, 0.10);
}

QFrame#ring_segment_cell[state="running"] {
    background-color: #ffd666;
}

QFrame#ring_segment_cell[state="done"] {
    background-color: #6fcf97;
}

QPushButton#library_view_toggle {
    background-color: transparent;
    border: 1px solid transparent;
    color: rgba(255, 255, 255, 0.55);
    padding: 4px 10px;
}

QPushButton#library_view_toggle:checked {
    background-color: rgba(123, 157, 188, 0.15);
    border-color: #35434f;
    border-radius: 5px;
    color: #7B9DBC;
}

/* QSS 画不出"窄线 + 宽热区"，手柄取 3px 兼顾分隔线观感和好抓取 */
QSplitter#library_splitter::handle:horizontal {
    width: 3px;
    background-color: rgba(100, 100, 100, 0.25);
}

QSplitter#library_splitter::handle:horizontal:hover {
    background-color: rgba(120, 160, 255, 0.5);
}

/* ────────────────────────────────────────────────────────────
   文字
   ──────────────────────────────────────────────────────────── */
QLabel#library_title {
    font-size: 18px;
    font-weight: 600;
    color: #DCDCDC;
    padding-bottom: 4px;
}

QLabel#library_section_title {
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.55);
}

QLabel#library_error {
    font-size: 12px;
    color: #f87171;
}

QLabel#library_form_label {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.55);
}

/* 全局只给 QTextEdit 配了样式，表单里的多行输入是 QPlainTextEdit */
QPlainTextEdit#library_text_edit {
    background-color: #0d1117;
    border: 0.5px solid rgba(255, 255, 255, 0.10);
    border-radius: 6px;
    padding: 5px 8px;
    color: #DCDCDC;
    selection-background-color: rgba(123, 157, 188, 0.35);
}

QPlainTextEdit#library_text_edit:focus {
    border-color: rgba(255, 255, 255, 0.25);
}

QPlainTextEdit#library_text_edit:disabled {
    background-color: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.25);
}

/* ────────────────────────────────────────────────────────────
   按钮：主操作（新建 / 创建 / 执行）、危险操作（删除）、返回
   圆角边框用不透明色（按 #101215 底色预先混合）：qss 分段画边和圆角，
   半透明色在接缝处叠两次，圆角会出现亮点
   ──────────────────────────────────────────────────────────── */
QPushButton#library_primary_btn {
    background-color: rgba(123, 157, 188, 0.15);
    border: 0.5px solid #35434f;
    color: #7B9DBC;
    font-weight: 600;
}

QPushButton#library_primary_btn:hover {
    background-color: rgba(123, 157, 188, 0.25);
    border-color: #4b5e71;
}

QPushButton#library_primary_btn:pressed {
    background-color: rgba(123, 157, 188, 0.35);
}

QPushButton#library_danger_btn {
    background-color: transparent;
    border: 0.5px solid #562e31;
    color: #f87171;
}

QPushButton#library_danger_btn:hover {
    background-color: rgba(248, 113, 113, 0.12);
}

QPushButton#library_primary_btn:disabled,
QPushButton#library_danger_btn:disabled {
    color: rgba(255, 255, 255, 0.25);
    background-color: rgba(255, 255, 255, 0.04);
    border-color: #1e2023;
}

QPushButton#library_back_btn {
    background-color: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.55);
    text-align: left;
    padding: 4px 6px;
}

QPushButton#library_back_btn:hover {
    color: #DCDCDC;
}

/* ────────────────────────────────────────────────────────────
   卡片（资源包 / 素材）
   ──────────────────────────────────────────────────────────── */
/* 边框同按钮，用预混合的不透明色避免圆角亮点 */
QWidget#library_card {
    background-color: rgba(255, 255, 255, 0.03);
    border: 0.5px solid #1e2023;
    border-radius: 8px;
}

QWidget#library_card:hover {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: #313336;
}

QWidget#library_card[selected="true"] {
    border-color: #5b738a;
    background-color: rgba(123, 157, 188, 0.10);
}

/* 没有图片时的占位：按分类给不同底色，对话、音效卡片也能一眼区分 */
QLabel#card_thumb {
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
    color: rgba(255, 255, 255, 0.45);
    font-size: 13px;
}

QLabel#card_thumb[category="scene"] { background-color: rgba(78, 201, 148, 0.10); }
QLabel#card_thumb[category="character"] { background-color: rgba(123, 157, 188, 0.12); }
QLabel#card_thumb[category="item"] { background-color: rgba(229, 192, 123, 0.10); }
QLabel#card_thumb[category="effect"] { background-color: rgba(198, 120, 221, 0.12); }
QLabel#card_thumb[category="dialogue"] { background-color: rgba(86, 182, 194, 0.12); }
QLabel#card_thumb[category="audio"] { background-color: rgba(224, 108, 117, 0.10); }

/* 悬停在卡片上才出现的操作按钮：半透明深底，盖在缩略图上也看得清 */
QPushButton#card_export_btn,
QPushButton#card_delete_btn {
    background-color: rgba(20, 22, 26, 0.72);
    border: 0.5px solid rgba(255, 255, 255, 0.12);
    border-radius: 13px;
    padding: 0;
}

/* 左上角的分层开关：常驻显示，选中（正在看分层）时换成强调色 */
QPushButton#card_layer_btn {
    background-color: rgba(20, 22, 26, 0.72);
    border: 0.5px solid rgba(255, 255, 255, 0.12);
    border-radius: 11px;
    padding: 0 9px;
    font-size: 11px;
}

QPushButton#card_layer_btn:hover {
    background-color: rgba(123, 157, 188, 0.55);
}

QPushButton#card_layer_btn:checked {
    background-color: rgba(123, 157, 188, 0.85);
}

QPushButton#card_export_btn:hover {
    background-color: rgba(123, 157, 188, 0.55);
}

QPushButton#card_delete_btn:hover {
    background-color: rgba(248, 113, 113, 0.55);
}

QPushButton#card_export_btn:disabled,
QPushButton#card_delete_btn:disabled {
    background-color: rgba(20, 22, 26, 0.45);
}

QLabel#card_name {
    font-size: 13px;
    color: #DCDCDC;
}

QLabel#card_meta {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.40);
}

/* 状态角标：待确认要用户动手，用实底最醒目；其余是描边淡底 */
QLabel#card_badge {
    font-size: 11px;
    padding: 1px 6px;
    border-radius: 4px;
    color: rgba(255, 255, 255, 0.45);
    background-color: rgba(255, 255, 255, 0.06);
}

QLabel#card_badge[status="review"] {
    color: #101215;
    background-color: #e5c07b;
    font-weight: 600;
}

QLabel#card_badge[status="running"] {
    color: #7B9DBC;
    background-color: rgba(123, 157, 188, 0.15);
}

QLabel#card_badge[status="error"] {
    color: #f87171;
    background-color: rgba(248, 113, 113, 0.12);
}

QLabel#card_badge[status="done"] {
    color: #4ec994;
    background-color: rgba(78, 201, 148, 0.12);
}

/* 卡片进度条是自绘的 ProgressStrip（activity.py），执行中要画流光，qss 做不到 */

/* 新建卡片的虚线框在 AddCard.paintEvent 里画，qss 的 dashed 不抗锯齿 */
QLabel#add_card_label {
    color: rgba(255, 255, 255, 0.35);
    font-size: 13px;
}

/* ────────────────────────────────────────────────────────────
   资源包详情：左侧树
   ──────────────────────────────────────────────────────────── */
QTreeWidget#library_tree {
    background-color: transparent;
    border: none;
    outline: none;
    color: rgba(255, 255, 255, 0.70);
}

QTreeWidget#library_tree::item {
    padding: 5px 4px;
}

QTreeWidget#library_tree::item:selected {
    background-color: rgba(123, 157, 188, 0.15);
    color: #DCDCDC;
}

/* 选中行左侧的展开箭头区域默认是系统高亮蓝，和整体配色冲突 */
QTreeWidget#library_tree {
    show-decoration-selected: 0;
}

QTreeWidget#library_tree::branch,
QTreeWidget#library_tree::branch:selected {
    background-color: transparent;
}

/* ────────────────────────────────────────────────────────────
   资源包详情：右侧素材详情
   ──────────────────────────────────────────────────────────── */
QLabel#detail_title {
    font-size: 15px;
    font-weight: 600;
    color: #DCDCDC;
}

QLabel#detail_heading {
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.45);
    padding-top: 6px;
}

QLabel#detail_text {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.80);
}

QScrollArea#ring_layer_scroll,
QScrollArea#ring_layer_scroll > QWidget > QWidget {
    background: transparent;
}

QPushButton#ring_layer_group {
    text-align: left;
    padding: 4px 6px;
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
    font-size: 12px;
}

QPushButton#ring_layer_group:hover {
    color: rgba(255, 255, 255, 0.85);
}

QFrame#ring_layer_row {
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.03);
}

QFrame#ring_layer_row[selectable="true"]:hover {
    background-color: rgba(255, 255, 255, 0.07);
}

QFrame#ring_layer_row[selected="true"] {
    border-color: #ffd666;
    background-color: rgba(255, 214, 102, 0.16);
}

QLabel#ring_layer_row_thumb {
    /* 图层是透明图：深灰底才看得出哪里有内容 */
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 3px;
}

QLabel#ring_layer_row_name {
    background: transparent;
    font-size: 12px;
}

QToolButton#ring_layer_eye {
    border: none;
    border-radius: 4px;
    background: transparent;
}

QToolButton#ring_layer_eye:hover {
    background-color: rgba(255, 255, 255, 0.10);
}

QToolButton#layer_fold {
    border: none;
    background: transparent;
    color: rgba(255, 255, 255, 0.55);
}

QLabel#layer_row_badge {
    background-color: rgba(255, 214, 102, 0.16);
    color: #ffd666;
    border-radius: 3px;
    padding: 1px 5px;
    font-size: 11px;
}

QFrame#layer_version {
    background: transparent;
}

QToolButton#layer_version_btn {
    border: none;
    border-radius: 3px;
    background: transparent;
    color: rgba(255, 255, 255, 0.75);
    padding: 2px 3px;
}

QToolButton#layer_version_btn:hover:enabled {
    background-color: rgba(255, 255, 255, 0.10);
}

QToolButton#layer_version_btn:disabled {
    color: rgba(255, 255, 255, 0.22);
}

QLabel#layer_version_label {
    background: transparent;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.75);
}

QLabel#detail_muted {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.40);
}

QLabel#detail_image {
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
}

QFrame#flow_step {
    background-color: rgba(255, 255, 255, 0.03);
    border: 0.5px solid #1e2023;
    border-radius: 6px;
}

QLabel#flow_step_name {
    font-size: 13px;
    color: #DCDCDC;
}

QLabel#flow_arrow {
    color: rgba(255, 255, 255, 0.25);
}

QPushButton#flow_redo_btn {
    background-color: transparent;
    border: 0.5px solid #2d2e31;
    color: rgba(255, 255, 255, 0.55);
    font-size: 11px;
    padding: 1px 8px;
}

QPushButton#flow_redo_btn:hover {
    color: #DCDCDC;
    border-color: #4c4d50;
}

QPushButton#flow_redo_btn:disabled {
    color: rgba(255, 255, 255, 0.20);
}

/* ────────────────────────────────────────────────────────────
   表格：新建表单的条目 / 角色表、剧本编辑（同设置页 model_table）
   ──────────────────────────────────────────────────────────── */
QTableWidget#library_table,
QTableWidget#script_table {
    background-color: #0d1117;
    border: 0.5px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    gridline-color: rgba(255, 255, 255, 0.05);
    outline: none;
}

QTableWidget#library_table::item,
QTableWidget#script_table::item {
    padding: 4px 8px;
    border: none;
}

/* ────────────────────────────────────────────────────────────
   新建资源包表单：固定顶栏 / 底栏；分类标签 + 模板小块 + 整包设置 + 条目 + 折叠的风格
   ──────────────────────────────────────────────────────────── */
QWidget#library_form_header,
QWidget#library_form_footer {
    background-color: #101215;
}

QWidget#library_form_footer {
    border-top: 0.5px solid rgba(100, 100, 100, 0.25);
}

/* 标题栏里的名称：平时像普通文字，悬停 / 编辑时才显出输入框 */
QLineEdit#library_name_edit {
    background-color: transparent;
    border: 0.5px solid transparent;
    color: #DCDCDC;
    font-size: 13px;
}

QLineEdit#library_name_edit:hover {
    border-color: rgba(255, 255, 255, 0.10);
}

QLineEdit#library_name_edit:focus {
    background-color: #0d1117;
    border-color: rgba(255, 255, 255, 0.25);
}

/* 分类标签：未选中只是暗色文字，选中变亮，下方指示条由代码滑过去 */
QPushButton#library_tab {
    background-color: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.45);
    font-size: 13px;
    padding: 6px 12px;
}

QPushButton#library_tab:hover {
    color: rgba(255, 255, 255, 0.80);
}

QPushButton#library_tab:checked {
    color: #DCDCDC;
    font-weight: 600;
}

QFrame#library_tab_indicator {
    background-color: #7B9DBC;
    border: none;
    border-radius: 1px;
}

/* 模板小块 / 角色小块：胶囊形，选中用强调色描边 */
QPushButton#library_chip,
QPushButton#library_chip_add {
    background-color: rgba(255, 255, 255, 0.04);
    border: 0.5px solid #26282b;
    border-radius: 14px;
    color: rgba(255, 255, 255, 0.70);
    padding: 4px 14px;
}

QPushButton#library_chip:hover,
QPushButton#library_chip_add:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #DCDCDC;
}

QPushButton#library_chip:checked,
QPushButton#library_chip[linked="true"] {
    background-color: rgba(123, 157, 188, 0.14);
    border-color: #4b5e71;
    color: #DCDCDC;
}

QPushButton#library_chip_add {
    padding: 4px 12px;
    font-weight: 600;
}

QLabel#library_form_summary {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.45);
}

/* 风格折叠行：一行摘要，点开展开编辑 */
QPushButton#library_style_toggle {
    background-color: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.55);
    padding: 4px 0px;
    text-align: left;
}

QPushButton#library_style_toggle:hover {
    color: #DCDCDC;
}

/* 条目行尾的 ⋯ / ×：悬停才出现，小而不抢眼 */
QToolButton#library_row_action {
    background-color: #1a1d22;
    border: 0.5px solid #2a2d31;
    border-radius: 5px;
    color: rgba(255, 255, 255, 0.60);
    min-width: 22px;
    min-height: 22px;
    font-size: 13px;
}

QToolButton#library_row_action:hover {
    background-color: #262a30;
    color: #DCDCDC;
}

/* 单独设置、编辑角色的浮层 */
QFrame#library_popup {
    background-color: #181b20;
    border: 0.5px solid #2c3036;
    border-radius: 8px;
}

/* 表单里的下拉统一补上箭头：全局样式把 drop-down 设成了无边框空白区 */
QWidget#pack_form QComboBox::down-arrow {
    image: url(:/svg/spin_down.svg);
    width: 10px;
    height: 10px;
}

/* 表格单元格里的下拉去掉底色和边框，和单元格融为一体，悬停时再显示出来 */
QTableWidget#library_table QComboBox {
    background-color: transparent;
    border: 0.5px solid transparent;
}

QTableWidget#library_table QComboBox:hover {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.12);
}

QTableWidget#library_table QHeaderView::section {
    font-size: 12px;
}

/* 次要操作（加行、删行、删预设）：只有文字，悬停才显出底色 */
QPushButton#library_ghost_btn {
    background-color: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.55);
    padding: 4px 10px;
}

QPushButton#library_ghost_btn:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: #DCDCDC;
}

QPushButton#library_ghost_btn:disabled {
    color: rgba(255, 255, 255, 0.20);
}

/* 主按钮"创建"：实心填充，放在固定底栏右侧 */
QPushButton#library_create_btn {
    background-color: #5b7c9b;
    border: 0.5px solid #6d8eac;
    border-radius: 6px;
    color: #ffffff;
    font-weight: 600;
    padding: 7px 28px;
}

QPushButton#library_create_btn:hover {
    background-color: #6a8cab;
}

QPushButton#library_create_btn:pressed {
    background-color: #4f6d89;
}

QPushButton#library_create_btn:disabled {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: #1e2023;
    color: rgba(255, 255, 255, 0.25);
}
