{
  "id": "character_motion",
  "version": 2,
  "type": "character",
  "source": "character",
  "name": "角色动作",
  "description": "绑定角色包里的一个角色，每个条目做一个动作（走、跑、待机……）的循环序列帧，输出精灵图、atlas JSON 和 GIF 预览。AI 起草会按绑定角色的样子写好动作描述（没有手脚的物体用弹跳、滚动来表现），可以先改再建包。每个动作约需 6 分钟。",
  "prompt_label": "动作描述",
  "cover": "sheet",
  "fields": [
    {"id": "loop_mode", "label": "循环方式", "default": "loop", "options": [
      {"value": "loop", "label": "自动找循环段（走、跑）"},
      {"value": "pingpong", "label": "往返播放（待机、呼吸）"}
    ]}
  ],
  "steps": [
    {"id": "video", "type": "animation.generate", "label": "生成动作视频", "inputs": ["@source"], "params": {"model_name": "Wan2.2-TI2V-Turbo", "width": 544, "height": 960, "num_frames": 49, "num_inference_steps": 4, "guidance_scale": 1.0, "scale": 0.9, "prompt_suffix": "2D game sprite animation, plain white background, the subject stays in place, static camera, smooth cyclic motion"}},
    {"id": "loop", "type": "frames.loop", "label": "截取循环段", "inputs": ["video"], "params": {"mode": "{loop_mode}", "skip": 8, "min_len": 8, "stride": 2}},
    {"id": "remove_bg", "type": "frames.remove_bg", "label": "逐帧去背景", "inputs": ["loop"], "params": {"model_name": "rembg-birefnet"}},
    {"id": "sheet", "type": "frames.sheet", "label": "精灵图", "deliverable": true, "inputs": ["remove_bg"], "params": {"fps": 12}}
  ]
}
