{
  "id": "scene_ground",
  "version": 1,
  "type": "scene",
  "name": "背景 + 地面",
  "description": "横版场景拆成背景和地面两张：背景画远处风景和天空，地面是角色脚下能站的地面横截面条带（顶部地表、下面土石层），裁掉透明边，引擎里贴画面底部放。背景在和地面交界处烘焙一条雾带和接地暗带，不让景物被地面一刀切断。两张同宽、都左右无缝可平铺，另出一张合成预览。背景描述和地面描述写的是同一个地方：背景描述只写远处风景和天空、不写脚下地面；地面描述只写地表和土石层（材质、颜色、边缘上的草或碎石），不写远景。",
  "prompt_label": "背景描述",
  "cover": "preview",
  "fields": [
    {"id": "ground", "label": "地面描述", "required": true}
  ],
  "steps": [
    {"id": "background_generate", "type": "image.generate", "label": "背景生成", "params": {"model_name": "Z-Image-Turbo", "width": 1344, "height": 768, "tile_mode": "horizontal", "prompt_suffix": "2D side-scrolling platformer game background, orthographic side view, straight-on camera, distant scenery and sky, scenery arranged side by side from left to right, no vanishing point, no characters, no text"}},
    {"id": "ground_generate", "type": "image.generate", "label": "地面生成", "params": {"model_name": "Z-Image-Turbo", "width": 1344, "height": 768, "tile_mode": "horizontal", "prompt": "{ground}", "prompt_suffix": "2D side-scrolling platformer ground, orthographic side view cross-section, one continuous ground band running across the whole width, flat walkable top surface, soil and rock layers below, isolated on plain white background, no characters, no text"}},
    {"id": "ground_remove_bg", "type": "image.remove_bg", "label": "地面去背景", "params": {"model_name": "rembg-birefnet"}, "inputs": ["ground_generate"]},
    {"id": "background_upscale", "type": "image.upscale", "label": "背景放大", "params": {"model_name": "RealESRGAN-anime-6B", "outscale": 2, "tile_mode": "horizontal"}, "inputs": ["background_generate"]},
    {"id": "ground_upscale", "type": "image.upscale", "label": "地面放大", "params": {"model_name": "RealESRGAN-anime-6B", "outscale": 2, "tile_mode": "horizontal"}, "inputs": ["ground_remove_bg"]},
    {"id": "ground", "type": "image.trim", "label": "地面", "deliverable": true, "params": {"padding": 0}, "inputs": ["ground_upscale"]},
    {"id": "background", "type": "image.ground_blend", "label": "背景", "deliverable": true, "params": {"fog": 0.35, "fog_height": 0.15, "shadow": 0.35, "shadow_height": 0.04}, "inputs": ["background_upscale", "ground"]},
    {"id": "preview", "type": "image.composite", "label": "合成预览", "deliverable": true, "params": {"align": "bottom"}, "inputs": ["background", "ground"]}
  ]
}
